<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="capiro"
        Arguments=""
        InstallLocation="C:\Program Files\rokuroo171\Capiro">
    </Installer>
    <PackageInformation
        PackageName="Capiro"
        PackageDisplayName="Capiro"
        PublisherName="CN=rokuroo171"
        PublisherDisplayName="rokuroo171"
        Version="0.1.0.0"
        PackageDescription="Turn screen captures into polished showcase assets.">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.rokuroo171.capiro"
                Description="Turn screen captures into polished showcase assets."
                DisplayName="Capiro"
                ExecutableName="capiro"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Capiro</DisplayName>
            <PublisherDisplayName>rokuroo171</PublisherDisplayName>
            <Description>Turn screen captures into polished showcase assets.</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="capiro.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
